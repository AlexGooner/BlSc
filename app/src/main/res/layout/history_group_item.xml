<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_background_light"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/device_name_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary_light"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="iPhone 12 Pro" />

            <ImageView
                android:id="@+id/favourite_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/favourite"
                android:src="@drawable/ic_star_filled"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/expand_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/expand_detections_group"
                android:src="@drawable/ic_expand_more" />

        </LinearLayout>

        <TextView
            android:id="@+id/mac_address_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            tools:text="AA:BB:CC:DD:EE:FF" />

        <TextView
            android:id="@+id/device_type_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp"
            tools:text="Телефон" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detection_count_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@color/border_light"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="5 обнаружений" />

            <TextView
                android:id="@+id/rssi_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@color/surface_light"
                android:padding="4dp"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                tools:text="-45 dBm" />

            <TextView
                android:id="@+id/location_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                tools:text="55.7558, 37.6176" />

        </LinearLayout>

        <TextView
            android:id="@+id/timestamp_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            tools:text="Последнее: 15.12.2024 14:30:25" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
